# Server-only environment variables. Never commit a real .env file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PORT=3001
NODE_ENV=production

# Used once to create/promote the initial admin account.
# Set these only in the deployment environment, then disable BOOTSTRAP_ADMIN.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
BOOTSTRAP_ADMIN=false
